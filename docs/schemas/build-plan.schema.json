{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AiBuildPlan",
  "description": "JSON schema for structures generated by the AI model for the AiBuild Minecraft plugin.",
  "type": "object",
  "required": ["name", "ops"],
  "properties": {
    "name": {
      "type": "string",
      "description": "A short, descriptive title for the planned structure (e.g. 'Three-Story Oak House')."
    },
    "ops": {
      "type": "array",
      "description": "Sequential operations executed in order to construct the structure. Later operations overwrite earlier ones.",
      "items": {
        "oneOf": [
          {
            "title": "FillBox",
            "description": "Solid cuboid between (x1, y1, z1) and (x2, y2, z2), corners inclusive.",
            "type": "object",
            "required": ["op", "x1", "y1", "z1", "x2", "y2", "z2", "block"],
            "properties": {
              "op": { "const": "fill" },
              "x1": { "type": "integer" },
              "y1": { "type": "integer" },
              "z1": { "type": "integer" },
              "x2": { "type": "integer" },
              "y2": { "type": "integer" },
              "z2": { "type": "integer" },
              "block": { "type": "string", "description": "Namespaced block id and optional blockstate properties (e.g. minecraft:oak_planks)" }
            }
          },
          {
            "title": "HollowBox",
            "description": "Hollow cuboid shell (6 faces). The inside remains untouched.",
            "type": "object",
            "required": ["op", "x1", "y1", "z1", "x2", "y2", "z2", "block"],
            "properties": {
              "op": { "const": "hollow_box" },
              "x1": { "type": "integer" },
              "y1": { "type": "integer" },
              "z1": { "type": "integer" },
              "x2": { "type": "integer" },
              "y2": { "type": "integer" },
              "z2": { "type": "integer" },
              "block": { "type": "string" }
            }
          },
          {
            "title": "Ellipse",
            "description": "Elliptical or circular wall rising for 'height' layers with given outer radii and wall thickness.",
            "type": "object",
            "required": ["op", "cx", "cz", "y", "rx", "rz", "block"],
            "properties": {
              "op": { "const": "ellipse" },
              "cx": { "type": "integer", "description": "Center X coordinate" },
              "cz": { "type": "integer", "description": "Center Z coordinate" },
              "y": { "type": "integer", "description": "Base layer Y coordinate" },
              "rx": { "type": "integer", "minimum": 1, "maximum": 256, "description": "Outer radius along X" },
              "rz": { "type": "integer", "minimum": 1, "maximum": 256, "description": "Outer radius along Z" },
              "height": { "type": "integer", "default": 1, "minimum": 1, "maximum": 256 },
              "thickness": { "type": "integer", "default": 1, "description": "Wall thickness. 0 creates a solid filled disc." },
              "block": { "type": "string" }
            }
          },
          {
            "title": "Arcade",
            "description": "Evenly spaced arched openings carved through an earlier ellipse with identical center and radii.",
            "type": "object",
            "required": ["op", "cx", "cz", "y", "rx", "rz", "count"],
            "properties": {
              "op": { "const": "arcade" },
              "cx": { "type": "integer" },
              "cz": { "type": "integer" },
              "y": { "type": "integer" },
              "rx": { "type": "integer", "minimum": 2, "maximum": 256 },
              "rz": { "type": "integer", "minimum": 2, "maximum": 256 },
              "count": { "type": "integer", "minimum": 1, "maximum": 256, "description": "Number of arched openings" },
              "width": { "type": "integer", "default": 3, "minimum": 1, "maximum": 32 },
              "height": { "type": "integer", "default": 5, "minimum": 2, "maximum": 64 },
              "thickness": { "type": "integer", "default": 1, "minimum": 1, "maximum": 32 },
              "offset_deg": { "type": "number", "default": 0, "description": "Angular rotation offset in degrees" },
              "block": { "type": "string", "default": "minecraft:air" }
            }
          },
          {
            "title": "Sphere",
            "description": "Spherical shell or dome.",
            "type": "object",
            "required": ["op", "cx", "cy", "cz", "r", "block"],
            "properties": {
              "op": { "const": "sphere" },
              "cx": { "type": "integer" },
              "cy": { "type": "integer" },
              "cz": { "type": "integer" },
              "r": { "type": "integer", "minimum": 1, "maximum": 64 },
              "hollow": { "type": "boolean", "default": false },
              "half": { "type": "string", "enum": ["top", "bottom", ""], "default": "" },
              "block": { "type": "string" }
            }
          },
          {
            "title": "SetBlock",
            "description": "Places a single specific block at (x, y, z). Used for doors, torches, lanterns, stairs, and decorations.",
            "type": "object",
            "required": ["op", "x", "y", "z", "block"],
            "properties": {
              "op": { "const": "setblock" },
              "x": { "type": "integer" },
              "y": { "type": "integer" },
              "z": { "type": "integer" },
              "block": { "type": "string", "description": "Namespaced block id and blockstates, e.g. minecraft:oak_door[half=lower,facing=north]" },
              "items": {
                "type": "array",
                "description": "Optional items placed inside container blocks (chests, barrels, dispensers).",
                "items": {
                  "type": "object",
                  "required": ["id"],
                  "properties": {
                    "id": { "type": "string", "description": "Item identifier, e.g. iron_ingot" },
                    "count": { "type": "integer", "default": 1, "minimum": 1, "maximum": 64 }
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}

